# ---- DuckDNS / Let's Encrypt (Pflicht für scripts/setup-certs.sh) ----
# Nur der Subdomain-Teil, ohne ".duckdns.org"
DUCKDNS_DOMAIN=meine-subdomain
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
# Optional: Kontakt-Mail für den Let's-Encrypt-Account (Ablauf-Warnungen)
ACME_EMAIL=

# ---- Ports auf dem Mac ----
MQTT_PLAIN_PORT=1883
MQTT_TLS_PORT=7006

# ---- GroBro ----
GROBRO_LOG_LEVEL=INFO
GROBRO_DUMP_MESSAGES=false
GROBRO_DEVICE_TIMEOUT=300
GROBRO_MAX_SLOTS=9
HA_BASE_TOPIC=homeassistant
TZ=Europe/Berlin

# ---- Datenbank + Dashboard ----
INFLUX_ORG=growatt
INFLUX_BUCKET=nexa
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=bitte-aendern
INFLUX_TOKEN=bitte-mit-openssl-rand-hex-32-erzeugen
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=bitte-aendern
GRAFANA_PORT=3000
MQTT_WS_PORT=9001
SETTINGS_PORT=8080
CLOUD_HOSTS=8.209.71.240,47.254.130.145

# ---- GroLo-Website, leer lassen = kein Push ----
# Läuft die Website im selben Stack (Profil "web"), zeigt WEB_URL auf den Container: http://grolo-web:3000
# Der Push verlässt das Haus dann gar nicht mehr. WEB_TOKEN ist derselbe Wert wie INGEST_TOKEN der Website.
WEB_URL=http://grolo-web:3000
WEB_TOKEN=
WEB_PUSH_INTERVAL=30

# ---- Datenbank der Website (Dienst grolo-db, Profil "web") ----
PGDATABASE=grolo
PGUSER=grolo
PGPASSWORD=bitte-eintragen
# Passwortschutz der Website. Leer lassen, wenn der Zugang davor geregelt wird (Cloudflare Access);
# dann zeigt die Seite keinen Login mehr. Gesetzt = Login wie gehabt.
SITE_PASSWORD=

# Verweise auf Einstellungsseite, Grafana und Wärmepumpe im Kopf der Website. Leer lassen, wenn die
# Hostnamen dem Muster <dienst>.<domain> folgen (pv./settings./grafana.) – dann findet die Seite sie selbst.
LINK_SETTINGS=
LINK_GRAFANA=
LINK_HEATPUMP=

# ---- Cloudflare-Tunnel (Profil "tunnel") ----
# Token aus Zero Trust -> Networks -> Tunnels -> <Tunnel> -> Install connector. Die Zuordnung
# Hostname -> Dienst (z. B. pv.<domain> -> http://grolo-web:3000) wird dort gepflegt, nicht hier.
CF_TUNNEL_TOKEN=

# ---- Weather (Open-Meteo, free, no key): location of the plant ----
# Standort der Anlage (Startwert; auf der Einstellungsseite per Ortssuche änderbar, das überschreibt diese Werte)
WEATHER_LAT=52.52
WEATHER_LON=13.405
WEATHER_NAME=
WEATHER_INTERVAL=600

# ---- Module je String (optional, ebenfalls auf der Einstellungsseite pflegbar) ----
# Neigung 0 = flach, 90 = senkrecht; Azimut = Blickrichtung 0 = Nord, 90 = Ost, 180 = Süd, 270 = West; WP = Nennleistung der Module am Eingang
# Grundlage für das Erwartungsmodell (Grafana „Gemessen vs. erwartet“, Website) und scripts/fit-orientation.py schätzt sie aus den Messdaten
STRING1_TILT=
STRING1_AZIMUTH=
STRING1_WP=
STRING2_TILT=
STRING2_AZIMUTH=
STRING2_WP=
# Performance-Ratio des Modells (Verluste durch Temperatur, Kabel, Verschmutzung), Standard 0.85
STRING_PR=0.85
# Ausrichtungsschätzung im Sidecar weather: Intervall in Sekunden (Standard 24 h, dazu jederzeit per Knopf auf der Einstellungsseite) und betrachtete Tage
FIT_INTERVAL=86400
FIT_DAYS=30

# Shelly-Nulleinspeisung (shelly-control): HTTP-Timeout beim Abfragen des Shelly in Sekunden
SHELLY_HTTP_TIMEOUT=2

# ---- Wärmepumpe: WOLF Link (CHA/FHA/BWL …), lokal über Port 9092, ohne Wolf-Cloud ----
# Die Dienste wolf und wolf-bridge starten nur, wenn das Profil aktiv ist:
# Für die mitgelieferte Website und den Cloudflare-Tunnel zusätzlich "web" und "tunnel" anhängen,
# also COMPOSE_PROFILES=wolf,tado,web,tunnel (setzt ../grolo-web, PGPASSWORD und CF_TUNNEL_TOKEN voraus).
COMPOSE_PROFILES=wolf,tado
# IP des WOLF Link und sein Gerätepasswort (dasselbe wie für http://<ip>/)
WOLF_HOST=192.168.1.57
WOLF_PASSWORD=bitte-eintragen
# Abfrageintervall von ism7mqtt in Sekunden und Veröffentlichungstakt der Bridge
WOLF_INTERVAL=30
WOLF_PUBLISH_INTERVAL=10
# Code für die Fachmann-Ebene der Bedienseite (wie der Fachmann-Code der Smartset-App, dort 1111).
# Leer lassen heißt: auch die Fachmann-Parameter sind ohne Code schreibbar.
WOLF_EXPERT_PIN=1111
